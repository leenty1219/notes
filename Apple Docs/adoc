def dash_page_docs(root):
    """Yield every DocC JSON page stored in a Dash Apple docset.

    Dash keeps 500k+ pages as brotli blobs under Contents/Resources/Documents/fs,
    sliced by the refs table of cache.db (offset/length into the decompressed blob).
    """
    try:
        import brotli
    except ImportError:
        sys.exit("brotli is missing; install it with: /usr/bin/pip3 install brotli")
    documents = os.path.join(os.path.expanduser(root), "Contents", "Resources", "Documents")
    cache = os.path.join(documents, "cache.db")
    fs_dir = os.path.join(documents, "fs")
    if not os.path.exists(cache):
        sys.exit("not a Dash docset: %s" % root)
    src = sqlite3.connect("file:%s?mode=ro&immutable=1" % cache, uri=True)
    slices = {}
    for _, data_id, offset, length in src.execute(
            "SELECT uuid, data_id, offset, length FROM refs"):
        slices.setdefault(data_id, []).append((offset, length))
    for data_id in sorted(slices):
        blob_file = os.path.join(fs_dir, str(data_id))
        if not os.path.exists(blob_file):
            continue
        with open(blob_file, "rb") as handle:
            raw = handle.read()
        try:
            data = brotli.decompress(raw)
        except Exception:
            continue
        for offset, length in slices[data_id]:
            chunk = data[offset:offset + length]
            if chunk[:1] != b"{":
                continue
            yield json.loads(chunk)


def oc_availability(doc):
    """(introduced, deprecated) for iOS/iPadOS; metadata uses platform/name key styles."""
    for wanted in IOS_PLATFORMS:
        for entry in doc.get("metadata", {}).get("platforms") or []:
            if (entry.get("platform") or entry.get("name")) != wanted:
                continue
            introduced = entry.get("introduced", entry.get("introducedAt"))
            try:
                introduced = float(introduced)
            except (TypeError, ValueError):
                introduced = None
            return introduced, bool(entry.get("deprecated"))
    return None


def md_summary(md):
    for block in md.split("\n\n"):
        text = block.strip()
        if not text or text.startswith(("<!--", "#", "```")):
            continue
        return " ".join(text.split())[:SUMMARY_LIMIT]
    return ""


def dash_release(root):
    info = os.path.join(os.path.expanduser(root), "Contents", "Info.plist")
    try:
        with open(info, "rb") as handle:
            return str(plistlib.load(handle).get("XcodeDocsVersion", ""))
    except (OSError, plistlib.InvalidFileException):
        return ""


def store_oc_rows(db, rows):
    db.executemany(
        "INSERT OR REPLACE INTO oc_pages (id, key, path, title, role_heading, md) "
        "VALUES (?, ?, ?, ?, ?, ?)", rows)
    db.commit()


def cmd_import_oc(args):
    db = connect()
    root = os.path.expanduser(args.docset or DASH_DOCSET)
    if not os.path.isdir(root):
        sys.exit("Dash docset not found: %s" % root)
    frameworks = {fw.lower() for fw, in db.execute("SELECT DISTINCT framework FROM pages")}
    db.execute("DELETE FROM pages WHERE lang='oc'")
    db.execute("DELETE FROM oc_pages")
    db.commit()
    ids = {key: pid for pid, key in db.execute("SELECT id, key FROM pages")}
    next_id = (db.execute("SELECT MAX(id) FROM pages").fetchone()[0] or 0) + 1
    attached = added = 0
    rows = []
    for doc in dash_page_docs(root):
        if doc.get("identifier", {}).get("interfaceLanguage") != OBJC_LANGUAGE:
            continue
        url = doc.get("identifier", {}).get("url", "")
        index = url.find(DOC_PREFIX)
        if index < 0:
            continue
        path = url[index:]
        key = path[len(DOC_PREFIX):].lower()
        framework = path[len(DOC_PREFIX):].split("/")[0]
        if framework.lower() not in frameworks:
            continue
        pid = ids.get(key)
        availability = None
        if pid is None:
            availability = oc_availability(doc)
            if availability is None:
                continue
        md = render_objc(doc)
        blob = zlib.compress(md.encode("utf-8"), 6)
        meta = doc.get("metadata", {})
        title = meta.get("title") or key.rsplit("/", 1)[-1]
        role = meta.get("roleHeading") or ""
        if pid is None:
            db.execute(
                "INSERT INTO pages (id, key, path, framework, title, kind, role_heading, "
                "summary, ios_introduced, ios_deprecated, depth, hash, lang) "
                "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'oc')",
                (next_id, key, path, framework, title, meta.get("symbolKind") or role, role,
                 md_summary(md), availability[0], int(availability[1]), key.count("/"),
                 hashlib.sha1(blob).hexdigest()))
            pid, next_id = next_id, next_id + 1
            added += 1
        else:
            attached += 1
        rows.append((pid, key, path, title, role, blob))
        if len(rows) >= BATCH:
            store_oc_rows(db, rows)
            rows = []
            print("  read %d pages" % (attached + added), file=sys.stderr)
    store_oc_rows(db, rows)
    db.execute("INSERT OR REPLACE INTO meta VALUES ('fts_ready', '0')")
    db.commit()
    rebuild_fts(db)
    meta = {
        "oc_imported_at": time.strftime("%Y-%m-%d %H:%M:%S"),
        "oc_docset": root,
        "oc_release": dash_release(root),
        "oc_pages": str(attached + added),
        "oc_only_pages": str(added),
        "fts_ready": "1",
    }
    db.executemany("INSERT OR REPLACE INTO meta VALUES (?, ?)", meta.items())
    db.commit()
    print("Objective-C pages: %d (%d attached to existing pages, %d OC-only)"
          % (attached + added, attached, added))


def cmd_objc(args):
    key = normalize_target(args.target)
    db = connect() if os.path.exists(DB_PATH) else None
    if db is not None:
        stored = db.execute("SELECT md FROM oc_pages WHERE key=?", (key,)).fetchone()
        if stored:
            sys.stdout.write(page_text(stored[0]))
            return
    if args.offline:
        sys.exit("no stored Objective-C docs for %s (drop --offline to fetch online)" % key)
    row = db.execute("SELECT path FROM pages WHERE key=?", (key,)).fetchone() if db else None
    path = row[0][len(DOC_PREFIX):] if row else key
    print("<!-- %s not in the local Objective-C set; fetched online -->" % key, file=sys.stderr)
    doc = fetch_docc(path)
    if doc is None:
        sys.exit("not found online: %s (check the key; Swift key or OC-only page path)" % path)
    objc = objc_document(doc)
    if objc is None:
        sys.exit("no Objective-C variant online for %s (Swift-only API)" % path)
    sys.stdout.write(render_objc(objc))


def cmd_info(_args):
    db = connect()
    meta = dict(db.execute("SELECT key, value FROM meta"))
    pages = db.execute("SELECT COUNT(*) FROM pages").fetchone()[0]
    swift = db.execute("SELECT COUNT(*) FROM pages WHERE lang='swift'").fetchone()[0]
    oc = db.execute("SELECT COUNT(*) FROM oc_pages").fetchone()[0]
    frameworks = db.execute("SELECT COUNT(DISTINCT framework) FROM pages").fetchone()[0]
    print("release: %s\nimported_at: %s\npages: %d (swift %d, oc-only %d)\n"
          "objective-c pages: %d\nframeworks: %d\nfts_ready: %s" % (
              meta.get("release"), meta.get("imported_at"), pages, swift, pages - swift,
              oc, frameworks, meta.get("fts_ready")))
    if meta.get("oc_imported_at"):
        print("oc source: Dash apple docset %s, imported_at: %s" % (
            meta.get("oc_release"), meta.get("oc_imported_at")))
    last = db.execute("SELECT ts, action, COUNT(*) FROM changes GROUP BY ts, action "
                      "ORDER BY ts DESC LIMIT 3").fetchall()
    for stamp, action, total in last:
        print("last change: %s %s %d" % (stamp, action, total))


def main():
    parser = argparse.ArgumentParser(prog="adoc", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    imp = sub.add_parser("import", help="build or merge the database from Xcode's asset")
    imp.add_argument("--source", help="documentation asset root directory")
    imp.set_defaults(func=cmd_import)
    ioc = sub.add_parser("import-oc", help="add Objective-C pages from a Dash Apple docset")
    ioc.add_argument("--docset", help="Dash .docset directory (default: Apple API Reference)")
    ioc.set_defaults(func=cmd_import_oc)
    sea = sub.add_parser("search", help="search names (default) or full text (--text)")
    sea.add_argument("query")
    sea.add_argument("-f", "--framework")
    sea.add_argument("-n", "--limit", type=int, default=20)
    sea.add_argument("--text", action="store_true")
    sea.set_defaults(func=cmd_search)
    sho = sub.add_parser("show", help="print a page as Markdown")
    sho.add_argument("target")
    sho.set_defaults(func=cmd_show)
    inf = sub.add_parser("info", help="database status")
    inf.set_defaults(func=cmd_info)
    obj = sub.add_parser("objc", help="Objective-C docs: local copy when stored, else online")
    obj.add_argument("target")
    obj.add_argument("--offline", action="store_true", help="never fetch online")
    obj.set_defaults(func=cmd_objc)
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
